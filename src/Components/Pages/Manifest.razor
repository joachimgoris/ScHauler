@page "/"
@inject ManifestService ManifestService

<PageTitle>Manifest - SC Hauler</PageTitle>

<div class="capacity panel">
    <div class="capacity-row">
        <span class="cap-label">Onboard</span>
        <span class="cap-value num">
            @_onboardScu
            <small>
                /
                <input class="cap-input num" type="number" min="0" @bind="_capacityScu"
                       @bind:after="SaveCapacityAsync" />
            </small>
        </span>
    </div>
    <label class="cap-here">
        <span class="cap-label">Docked at</span>
        <select class="cap-select" @bind="_currentLocation" @bind:after="SaveCurrentLocationAsync">
            <option value="" disabled>Where are you?</option>
            @foreach (var location in _locations)
            {
                <option value="@location.Id.Value">@location.Name</option>
            }
        </select>
    </label>
    @if (_capacityScu > 0)
    {
        <div class="cap-track @(_onboardScu > _capacityScu ? "over" : null)" role="progressbar" aria-valuenow="@_onboardScu" aria-valuemin="0"
             aria-valuemax="@_capacityScu">
            @foreach (var d in _destinations)
            {
                <div class="cap-seg" style="--c: @_colors[d.Name]; width: @(Percent(d.AboardScu))%"></div>
                <div class="cap-seg cap-seg-pending" style="--c: @_colors[d.Name]; width: @(Percent(d.PendingScu))%"></div>
            }
        </div>
        @if (_destinations.Count > 0)
        {
            <ul class="cap-legend">
                @foreach (var (d, index) in _destinations.Select((d, i) => (d, i)))
                {
                    <li class="cap-chip" style="--c: @_colors[d.Name]">
                        <span class="route-stop-badge num">@(index + 1)</span>
                        <span>@d.Name</span>
                        <span class="cap-chip-scu num">@d.AboardScu<small>/@(d.AboardScu + d.PendingScu) SCU</small></span>
                    </li>
                }
            </ul>
        }
        @if (_onboardScu > _capacityScu)
        {
            <p class="cap-warning">Overloaded by @(_onboardScu - _capacityScu) SCU</p>
        }
    }
</div>
@if (_pickUpNote is not null)
{
    <p class="pickup-note panel" role="status">@_pickUpNote</p>
}
<div class="manifest-body">
    <HoldView Hold="_hold" Colors="_colors" Destinations="_destinations" Conflicts="_conflicts" UnreservedScu="_unreservedScu"
              Isolated="@_isolated" OnToggleIsolate="ToggleIsolate" />
    <RouteManifest Stops="_stops" Hold="_hold" Destinations="_destinations" Colors="_colors" Isolated="@_isolated" Pinned="_dropOrderPinned"
                   OnToggleIsolate="ToggleIsolate" OnMove="MoveStopAsync" OnClearOrder="ClearDropOrderAsync" OnDeliver="DeliverAsync" />
</div>

@if (_stops.Count == 0)
{
    <div class="empty panel">
        <p>No active cargo.</p>
        <a class="btn-new" href="/contracts/new">Log a contract</a>
    </div>
}

@foreach (var stop in _stops)
{
    var pickups = stop.Actions.Where(a => a.Kind == ActionKind.Pickup).ToList();
    if (pickups.Count == 0)
    {
        continue;
    }
    <section class="stop panel">
        <header class="stop-head">
            <h2>@stop.LocationName</h2>
            <div class="stop-tally num">
                @if (stop.DeliverScu > 0)
                {
                    <span class="tag deliver">&#9660; @stop.DeliverScu SCU</span>
                }
                @if (stop.PickupScu > 0)
                {
                    <span class="tag pickup">&#9650; @stop.PickupScu SCU</span>
                }
            </div>
        </header>

        @foreach (var action in pickups)
        {
            @if (action.Kind == ActionKind.Pickup && _pickingUp == action.CargoLineId)
            {
                <div class="pickup-entry">
                    <p class="pickup-entry-title">@action.Commodity - tap the boxes at hand</p>
                    @if (AdviceText() is { } advice)
                    {
                        <p class="pickup-advice" role="status">@advice</p>
                    }
                    <BoxCounters Counts="_pickUpCounts" OnChanged="StateHasChanged" />
                    <div class="pickup-entry-actions">
                        <span class="pickup-total num">@PickupTotal / @action.Scu SCU</span>
                        <button class="btn-primary" disabled="@(PickupTotal != action.Scu)"
                                @onclick="() => ConfirmPickUpAsync(action.CargoLineId)">CONFIRM PICK UP</button>
                        <button class="btn-plain" @onclick="() => _pickingUp = null">Cancel</button>
                    </div>
                </div>
            }
            else
            {
                <button class="action @(action.Kind == ActionKind.Pickup ? "pickup" : "deliver")"
                        @onclick="() => ActionTappedAsync(action)">
                    <span class="verb">@(action.Kind == ActionKind.Pickup ? "PICK UP" : "DELIVER")</span>
                    <span class="cargo">
                        @action.Commodity
                        <small class="contract-ref">@action.ContractName</small>
                        @if (action.Boxes.Count > 0)
                        {
                            <small class="boxes num">@string.Join(" · ", action.Boxes.Select(b => $"{b.Count}× {b.Size.Value} SCU"))</small>
                        }
                    </span>
                    <span class="scu num">@action.Scu <small>SCU</small></span>
                </button>
            }
        }
    </section>
}

@code {
    private CargoLineId? _pickingUp;
    private Dictionary<ContainerSize, int> _pickUpCounts = [];
    private Services.HoldView _hold = new([], 0, []);

    // Design token pool; assigned to destinations in drop order, stable everywhere.
    private static readonly string[] DestinationColors =
        ["#a78bfa", "#6cb8e8", "#5fd0a8", "#f87171", "#a3e635", "#fb923c"];

    private string? _isolated;
    private IReadOnlyList<Destination> _destinations = [];
    private bool _dropOrderPinned;
    private PickUpAdvice? _advice;
    private Dictionary<string, string> _colors = new(StringComparer.OrdinalIgnoreCase);
    private IReadOnlyList<StowConflict> _conflicts = [];
    private int _unreservedScu;
    private string? _pickUpNote;

    private int PickupTotal => _pickUpCounts.Sum(kv => kv.Key.Value * kv.Value);

    private IReadOnlyList<LocationStop> _stops = [];
    private int _onboardScu;
    private int _capacityScu;
    private IReadOnlyList<Location> _locations = [];
    private string _currentLocation = "";

    private int Percent(int scu) => _capacityScu <= 0
        ? 0
        : Math.Min(100, (int)Math.Round(scu * 100.0 / _capacityScu));

    protected override Task OnInitializedAsync() => RefreshAsync();

    // Route order is the default; a ▲/▼ tap pins the list on the ship until "ROUTE ORDER" clears it.
    private async Task RefreshAsync()
    {
        var snapshot = await ManifestService.GetManifestAsync();
        _stops = snapshot.Stops;
        _onboardScu = snapshot.OnboardScu;
        _capacityScu = snapshot.CapacityScu;
        _hold = snapshot.Hold;
        _locations = snapshot.Locations;
        _currentLocation = snapshot.CurrentLocationId?.Value.ToString() ?? "";
        _destinations = snapshot.Destinations;
        _dropOrderPinned = snapshot.DropOrderPinned;
        _unreservedScu = snapshot.UnreservedScu;
        _colors = _destinations
            .Select((d, index) => (d.Name, Color: DestinationColors[index % DestinationColors.Length]))
            .ToDictionary(x => x.Name, x => x.Color, StringComparer.OrdinalIgnoreCase);
        _conflicts = ManifestPlanner.StowCheck(_hold, [.. _destinations.Select(d => d.Name)]);
    }

    private void ToggleIsolate(string dest) =>
        _isolated = string.Equals(_isolated, dest, StringComparison.OrdinalIgnoreCase) ? null : dest;

    private async Task MoveStopAsync((LocationId Id, int Delta) move)
    {
        var order = _destinations.Select(d => d.Id).ToList();
        var from = order.IndexOf(move.Id);
        var to = from + move.Delta;
        if (from < 0 || to < 0 || to >= order.Count)
        {
            return;
        }

        (order[from], order[to]) = (order[to], order[from]);
        await ManifestService.PinDropOrderAsync(order);
        await RefreshAsync();
    }

    private async Task ClearDropOrderAsync()
    {
        await ManifestService.ClearDropOrderAsync();
        await RefreshAsync();
    }

    private async Task SaveCapacityAsync()
    {
        await ManifestService.SetCapacityAsync(_capacityScu);
        await RefreshAsync();
    }

    private async Task DeliverAsync(CargoLineId cargoLineId)
    {
        _pickUpNote = null;
        await ManifestService.AdvanceAsync(cargoLineId);
        await RefreshAsync();
    }

    private async Task ActionTappedAsync(StopAction action)
    {
        _pickingUp = action.CargoLineId;
        _pickUpCounts = ContainerSize.All.ToDictionary(s => s, s => action.Boxes.FirstOrDefault(b => b.Size == s)?.Count ?? 0);
        _advice = null;
        _advice = await ManifestService.AdviseAsync(action.CargoLineId);
    }

    private string? AdviceText() => _advice switch
    {
        null or { HoldKnown: false } => null,
        { Overflow: true } => "WON'T FIT — exceeds the hold's capacity.",
        { Fit: null } => "WON'T FIT — no box mix fits, even after a restow.",
        { Fit: var fit } => $"FITS as {fit.LargestBox.Value} SCU boxes or smaller" + fit.Tier switch
        {
            StowTier.Planned => ".",
            StowTier.Tight => " — tight stow, piles touch.",
            StowTier.Restowed => " — restow needed.",
            _ => " — restow needed, tight stow.",
        },
    };

    private async Task ConfirmPickUpAsync(CargoLineId cargoLineId)
    {
        var sizes = ContainerSize.All.SelectMany(s => Enumerable.Repeat(s, _pickUpCounts.GetValueOrDefault(s))).ToList();

        var result = await ManifestService.PickUpAsync(cargoLineId, sizes);
        _pickUpNote = result.Outcome switch
        {
            PickUpOutcome.Overflow => $"NOT LOADED — {sizes.Sum(s => s.Value)} SCU would exceed the hold: {_onboardScu} / {_capacityScu} SCU aboard.",
            PickUpOutcome.DoesNotFit => "NOT LOADED — these boxes do not fit in the hold, even after restowing everything. The line stays pending.",
            PickUpOutcome.Restowed => $"RESTOW — {result.MovedBoxes} box(es) already aboard changed place. Reload the hold to match the plan.{(result.Tight ? " Tight stow: piles touch, follow the stop numbers." : "")}",
            PickUpOutcome.Planned when result.Tight => "TIGHT STOW — no room for a gap between piles; follow the stop numbers on the hold plan.",
            _ => null,
        };
        _pickingUp = null;
        await RefreshAsync();
    }

    private async Task SaveCurrentLocationAsync()
    {
        if (!Guid.TryParse(_currentLocation, out var guid))
        {
            return;
        }

        await ManifestService.SetCurrentLocationAsync(new LocationId(guid));
        await RefreshAsync();
    }
}
